{
  parserClass="me.hql.linhscript.parser.LinhScriptParser"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="LinhScript"
  psiImplPackage="me.hql.linhscript.psi.impl"
  psiPackage="me.hql.linhscript.psi"

  elementTypeHolderClass="me.hql.linhscript.psi.LinhScriptTypes"
  elementTypeClass="me.hql.linhscript.psi.LinhScriptElementType"
  tokenTypeClass="me.hql.linhscript.psi.LinhScriptTokenType"

  psiImplUtilClass="me.hql.linhscript.psi.impl.LinhScriptPsiImplUtil"

  tokens = [
      USE="use"
      VAR="var"
      PRINT="print"
      INPUT="input"
      IF="if"
      ELSE="else"
      SWITCH="switch"
      CASE="case"
      DEFAULT="default"
      BREAK="break"
      CONTINUE="continue"
      WHILE="while"
      FOR="for"
      TO="to"
      IN="in"
      RANDOM="random"
      FUNC="func"
      CALL="call"
      RETURN="return"
      ADD="add"
      SIZE="size"
      LEN="len"
      PUSH="push"
      POP="pop"
      TYPE="type"
      STR="str"
      NUM="num"
      BOOL="bool"
      READ="read"
      WRITE="write"
      TRUE="true"
      FALSE="false"
      NULL="null"
      NOT="not"
      IMPORT="import"
      CLASS="class"
      EXTENDS="extends"
      NEW="new"
      TRY="try"
      CATCH="catch"
      FINALLY="finally"
      THROW="throw"

      COMMA=","
      SEMI=";"
      COLON=":"
      QUESTION="?"
      DOT="."
      OP_NOT="!"
      OP_ASSIGN="="
      OP_PLUS_ASSIGN="+="
      OP_MINUS_ASSIGN="-="
      OP_MUL_ASSIGN="*="
      OP_DIV_ASSIGN="/="
      OP_INC="++"
      OP_DEC="--"
      OP_PLUS="+"
      OP_MINUS="-"
      OP_MUL="*"
      OP_DIV="/"
      OP_MOD="%"
      OP_POW="^"
      OP_EQ="=="
      OP_NE="!="
      OP_GT=">"
      OP_LT="<"
      OP_GE=">="
      OP_LE="<="
      OP_AND="&&"
      OP_OR="||"
      L_PAREN="("
      R_PAREN=")"
      L_BRACE="{"
      R_BRACE="}"
      L_BRACKET="["
      R_BRACKET="]"

      COMMENT="regexp:#[^\r\n]*|//[^\r\n]*|/\*[\s\S]*?\*/"
      CRLF="regexp:\r?\n"
      NUMBER="regexp:[0-9]+(\.[0-9]+)?"
      STRING='regexp:"""([^"]|"[^"]|""[^"])*"""|"([^"\\]|\\.)*"'
      IDENTIFIER="regexp:@?[a-zA-Z_][a-zA-Z0-9_]*"
    ]
}

linhScriptFile ::= item_*

private item_ ::= (stmt SEMI? | COMMENT | CRLF | SEMI)

stmt ::=
    use_stmt
  | import_stmt
  | class_def_stmt
  | func_def_stmt
  | try_stmt
  | throw_stmt
  | postfix_stmt
  | var_assignment_stmt
  | print_stmt
  | return_stmt
  | break_stmt
  | continue_stmt
  | if_stmt
  | switch_stmt
  | while_stmt
  | for_stmt
  | expr_stmt

import_stmt ::= IMPORT STRING SEMI?

class_def_stmt ::= CLASS IDENTIFIER (EXTENDS IDENTIFIER)? L_BRACE class_item_* R_BRACE
private class_item_ ::= (class_member SEMI? | COMMENT | CRLF | SEMI)
class_member ::= func_def_stmt | class_field_stmt
class_field_stmt ::= VAR IDENTIFIER (OP_ASSIGN expr)?

throw_stmt ::= THROW expr

postfix_stmt ::= postfix_expr (OP_INC | OP_DEC)

var_assignment_stmt ::= VAR? postfix_expr (OP_ASSIGN | OP_PLUS_ASSIGN | OP_MINUS_ASSIGN | OP_MUL_ASSIGN | OP_DIV_ASSIGN) expr {
  methods=[getNameIdentifier]
}

use_stmt ::= USE IDENTIFIER (DOT IDENTIFIER)* SEMI? {
  pin=1
}

try_stmt ::= TRY block (CATCH (L_PAREN IDENTIFIER R_PAREN)? block)? (FINALLY block)?

block ::= L_BRACE item_* R_BRACE

func_def_stmt ::= FUNC IDENTIFIER L_PAREN param_list? R_PAREN block {
  methods=[getNameIdentifier]
}

param_list ::= IDENTIFIER (COMMA IDENTIFIER)*
arg_list ::= expr (COMMA expr)*

print_stmt ::= PRINT L_PAREN expr R_PAREN
return_stmt ::= RETURN expr?
break_stmt ::= BREAK
continue_stmt ::= CONTINUE

if_stmt ::= IF L_PAREN expr R_PAREN block (CRLF* ELSE (CRLF* if_stmt | CRLF* block))? {
  pin=1
}
switch_stmt ::= SWITCH L_PAREN expr R_PAREN L_BRACE switch_item_* R_BRACE
private switch_item_ ::= (switch_clause | item_)
switch_clause ::= (CASE expr | DEFAULT) COLON

while_stmt ::= WHILE L_PAREN expr R_PAREN block
range_expr ::= add_expr (OP_RANGE add_expr)?
for_stmt ::= FOR IDENTIFIER IN range_expr block

expr_stmt ::= expr

expr ::=
    ternary_expr
  | or_expr
  | and_expr
  | compare_expr
  | add_expr
  | mul_expr
  | pow_expr
  | unary_expr
  | postfix_expr
  | map_expr
  | array_expr
  | paren_expr
  | literal_expr

ternary_expr ::= or_expr (QUESTION expr COLON expr)?
or_expr ::= and_expr (OP_OR and_expr)*
and_expr ::= compare_expr (OP_AND compare_expr)*
compare_expr ::= add_expr ((OP_EQ | OP_NE | OP_GT | OP_LT | OP_GE | OP_LE) add_expr)*
add_expr ::= mul_expr ((OP_PLUS | OP_MINUS) mul_expr)*
mul_expr ::= pow_expr ((OP_MUL | OP_DIV | OP_MOD) pow_expr)*
pow_expr ::= unary_expr (OP_POW unary_expr)*
unary_expr ::= (NOT | OP_NOT | OP_MINUS | OP_PLUS) unary_expr | postfix_expr

member_name ::= IDENTIFIER | LEN | SIZE | TYPE | STR | NUM | BOOL | PRINT | INPUT | RANDOM | ADD | PUSH | POP | READ | WRITE
postfix_expr ::= primary_expr (DOT member_name | L_BRACKET expr R_BRACKET | L_PAREN arg_list? R_PAREN)*
primary_expr ::= new_expr | call_expr | variable_expr | literal_expr | paren_expr

new_expr ::= NEW IDENTIFIER (L_PAREN arg_list? R_PAREN)?

call_expr ::=
    CALL (IDENTIFIER | INPUT | PRINT | LEN | SIZE | TYPE | STR | NUM | BOOL | RANDOM | ADD | PUSH | POP | READ | WRITE) L_PAREN arg_list? R_PAREN
  | (IDENTIFIER | CALL | INPUT | PRINT | LEN | SIZE | TYPE | STR | NUM | BOOL | RANDOM | ADD | PUSH | POP | READ | WRITE) L_PAREN arg_list? R_PAREN

literal_expr ::= NUMBER | STRING | TRUE | FALSE | NULL
variable_expr ::= IDENTIFIER
paren_expr ::= L_PAREN expr R_PAREN

array_expr ::= L_BRACKET (CRLF* expr (CRLF* COMMA CRLF* expr)* (CRLF* COMMA)? CRLF*)? R_BRACKET
map_expr ::= L_BRACE (CRLF* map_entry (CRLF* COMMA CRLF* map_entry)* (CRLF* COMMA)? CRLF*)? R_BRACE
map_entry ::= (STRING | IDENTIFIER | NUMBER | L_BRACKET expr R_BRACKET) COLON expr